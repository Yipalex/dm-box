# Copy to .env. Generate a token: python3 -c 'import secrets; print(secrets.token_hex(32))'
DMBOX_API_TOKEN=
# Existing NAS-local directory; never an SMB/NFS mount from another machine.
DMBOX_HOST_DATA_DIR=/volume1/docker/dmbox/data
# Use the actual NAS LAN IP for LAN access. Loopback is the safe default.
DMBOX_BIND_IP=127.0.0.1
DMBOX_PORT=8765
# NAS account UID/GID with read/write permission on the data directory.
DMBOX_UID=10001
DMBOX_GID=10001
